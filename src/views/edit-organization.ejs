<%- include('partials/header') %>
  <main id="form-page" class="form-page">
    <h1>
      <%= title %>
    </h1>

    <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST">
      <div class="form-group">
        <label for="name">Organization Name</label>
        <input type="text" id="name" value="<%= organizationDetails.name %>" name="name" required maxlength="150" />
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" required maxlength="500"><%= organizationDetails.description %></textarea>
      </div>

      <div class="form-group">
        <label for="contactEmail">Contact Email</label>
        <input type="email" id="contactEmail" value="<%= organizationDetails.contact_email %>" name="contactEmail" required />
      </div>

      <div class="form-group">
        <label for="logoFilename">Logo Filename</label>
        <input type="text" id="logoFilename" name="logoFilename" value="<%= organizationDetails.logo_filename %>" required />
      </div>

      <button type="submit">Update Organization</button>
    </form>

  </main>
  <%- include('partials/footer') %>